rules_version = '2';

// Each user's data lives under users/{uid}. Only that signed-in user can
// read or write it; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOptionalString(data, field, maxSize) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function isOptionalIdList(data, field) {
      return !(field in data)
        || (data[field] is list && data[field].size() <= 100);
    }

    function isValidLabel(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.keys().hasOnly(['name', 'createdAt', 'parentId', 'shareId'])
        && isOptionalString(data, 'parentId', 100)
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 50
        && data.createdAt is timestamp;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll([
          'url', 'canonicalUrl', 'title', 'source', 'sourceDomain',
          'readingStatus', 'archived', 'inInbox', 'createdAt', 'updatedAt',
          'searchTokens'
        ])
        && data.keys().hasOnly([
          'url', 'canonicalUrl', 'title', 'description', 'imageUrl', 'source',
          'sourceDomain', 'readingStatus', 'archived', 'inInbox', 'createdAt',
          'updatedAt', 'searchTokens', 'tagIds', 'collectionIds',
          'importedFrom', 'importedAt', 'favorite', 'note', 'type', 'remindAt', 'contentIndexedAt',
          'deletedAt'
        ])
        && data.url is string && data.url.size() <= 4096
        && data.url.matches('^https?://.+')
        && data.canonicalUrl is string && data.canonicalUrl.size() <= 4096
        && data.title is string && data.title.size() <= 1000
        && isOptionalString(data, 'description', 5000)
        && isOptionalString(data, 'imageUrl', 4096)
        && data.source is string && data.source.size() <= 50
        && data.sourceDomain is string && data.sourceDomain.size() <= 255
        && data.readingStatus in ['saved', 'readLater', 'reading', 'read']
        && data.archived is bool
        && data.inInbox is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        // Allow for client clock skew, but not dates far in the future.
        && data.updatedAt <= request.time + duration.value(1, 'h')
        && data.searchTokens is list && data.searchTokens.size() <= 400
        && isOptionalIdList(data, 'tagIds')
        && isOptionalIdList(data, 'collectionIds')
        && isOptionalString(data, 'importedFrom', 50)
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && (!('favorite' in data) || data.favorite is bool)
        && isOptionalString(data, 'note', 10000)
        && (!('remindAt' in data) || data.remindAt is timestamp)
        && (!('contentIndexedAt' in data) || data.contentIndexedAt is timestamp)
        && (!('deletedAt' in data) || data.deletedAt is timestamp)
        && (!('type' in data) || data.type in
          ['article', 'video', 'image', 'document', 'post', 'product']);
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidBookmark(request.resource.data)
        && request.resource.data.createdAt <= request.time + duration.value(1, 'h');

      allow update: if isOwner(userId)
        && isValidBookmark(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.url == resource.data.url
        && request.resource.data.canonicalUrl == resource.data.canonicalUrl;
    }

    function isValidHighlight(data) {
      return data.keys().hasAll(['bookmarkId', 'text', 'color', 'createdAt'])
        && data.keys().hasOnly(['bookmarkId', 'text', 'note', 'color', 'createdAt'])
        && data.bookmarkId is string && data.bookmarkId.size() <= 100
        && data.text is string && data.text.size() > 0 && data.text.size() <= 5000
        && isOptionalString(data, 'note', 10000)
        && (!('remindAt' in data) || data.remindAt is timestamp)
        && (!('contentIndexedAt' in data) || data.contentIndexedAt is timestamp)
        && data.color in ['yellow', 'green', 'blue', 'pink']
        && data.createdAt is timestamp;
    }

    // Page text words for full-text search, one document per bookmark.
    match /users/{userId}/contents/{bookmarkId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
        && request.resource.data.words is list
        && request.resource.data.words.size() <= 3000
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/highlights/{highlightId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidHighlight(request.resource.data);
      allow update: if isOwner(userId)
        && isValidHighlight(request.resource.data)
        && request.resource.data.text == resource.data.text
        && request.resource.data.bookmarkId == resource.data.bookmarkId;
    }

    // Tags and collections.
    match /users/{userId}/{labelKind}/{labelId} {
      allow read, delete: if isOwner(userId)
        && labelKind in ['tags', 'collections'];

      allow create: if isOwner(userId)
        && labelKind in ['tags', 'collections']
        && isValidLabel(request.resource.data)
        && !('shareId' in request.resource.data);

      allow update: if isOwner(userId)
        && labelKind in ['tags', 'collections']
        && isValidLabel(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        // Public links are managed by the API server only.
        && request.resource.data.get('shareId', null)
          == resource.data.get('shareId', null);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
