# Copy to .env (cp env.example .env) and fill in. Kept only on the server.

# The address the API is served at. Point its DNS record at this server.
# No domain? Use <server-ip>.sslip.io, e.g. 203.0.113.7.sslip.io
API_DOMAIN=api.example.com

# The image the API workflow publishes. API_VERSION is set by each deploy.
API_IMAGE=ghcr.io/ozais49/capsula-api
API_VERSION=latest

FIREBASE_PROJECT_ID=capsula-ygtech
CORS_ORIGINS=https://capsula-ygtech.web.app,https://capsula-ygtech.firebaseapp.com
RATE_LIMIT_PER_MINUTE=120
