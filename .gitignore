# ---------------------------------------------------------------------------
# Secrets: never commit these.
# ---------------------------------------------------------------------------

# Firebase / Google Cloud service account keys (grant full project access).
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
api/secrets/

# Android release signing.
key.properties
*.jks
*.keystore

# Environment files.
.env
.env.*

# ---------------------------------------------------------------------------
# Build output and caches
# ---------------------------------------------------------------------------

# Flutter / Dart
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
api/build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Android Studio places build artifacts here.
/android/app/debug
/android/app/profile
/android/app/release

# Built packages outside build/.
*.apk
*.aab

# Symbolication and obfuscation maps.
app.*.symbols
app.*.map.json

# Widget previews.
.widget_preview/

# Node (rules tests)
node_modules/

# Firebase CLI: hosting deploy cache and emulator logs.
.firebase/
*-debug.log
firebase-debug.*.log

# ---------------------------------------------------------------------------
# Editors, tools and OS files
# ---------------------------------------------------------------------------

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: share the launch configurations, keep personal settings local.
.vscode/*
!.vscode/launch.json

# Local AI/agent tool settings.
.claude/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
